# Payload CMS — copy to .env.local and fill in values
# On Vercel: add both vars for Production, Preview, AND Build environments
PAYLOAD_SECRET=your-secret-at-least-32-chars-long

# Local development (SQLite)
DATABASE_URL=file:./payload.db

# Production on Vercel (Postgres — use the URL from Vercel Storage / Neon)
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
# POSTGRES_URL=postgres://user:password@host:5432/database?sslmode=require
# channel_binding is stripped automatically — sslmode=require is recommended

# Vercel Blob (required for production media uploads)
# OIDC vars (BLOB_STORE_ID, VERCEL_OIDC_TOKEN) are not enough for Payload yet — you still need:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# In Vercel: Storage → your Blob store → connect to project → ensure this token is added
# for Production, Preview, and Build (not just OIDC / BLOB_STORE_ID).

# Optional public links (frontend)
# NEXT_PUBLIC_SCHEDULE_URL=https://cal.com/your-username/intro
# NEXT_PUBLIC_NOTEBOOKLM_URL=https://notebooklm.google.com/notebook/your-notebook-id
